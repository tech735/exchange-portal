# Email Service Configuration
VITE_RESEND_API_KEY=your_resend_api_key_here

# Get your API key from: https://resend.com/api-keys
# After setting up your account, replace 'your_resend_api_key_here' with your actual API key

# Team ticket-update notifications (notify-team + escalate-tickets Edge Functions)
# These are server-side secrets — set them with `supabase secrets set`, NOT in this file:
#   RESEND_API_KEY=your_resend_api_key_here
#   RESEND_FROM_EMAIL=team@yourdomain.com
#   TEAM_NOTIFICATION_EMAILS=ops@yourdomain.com,warehouse@yourdomain.com
#   ADMIN_NOTIFICATION_EMAIL=tech@kotu.co.in
# ADMIN_NOTIFICATION_EMAIL receives: exchange-booked detail emails and the
# hourly SLA-escalation summary (tickets open more than 2 days).
# See supabase/migrations/20260707120000_add_ticket_notification_trigger.sql and
# 20260708090000_add_ticket_escalation_cron.sql for the vault secrets
# (project_functions_url, service_role_key) both the trigger and cron job need.
